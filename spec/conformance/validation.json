                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "input: add two numbers",
      "valid": true,
      "spec": {
        "specVersion": 1,
        "id": "w",
        "title": "T",
        "slot": "home.top",
        "state": {
          "a": null,
          "b": null
        },
        "root": {
          "type": "card",
          "children": [
            {
              "type": "input",
              "kind": "number",
              "bind": "a",
              "label": "First number"
            },
            {
              "type": "input",
              "kind": "number",
              "bind": "b",
              "label": "Second number"
            },
            {
              "type": "metric",
              "label": "Sum",
              "value": {
                "+": [
                  {
                    "var": "state.a"
                  },
                  {
                    "var": "state.b"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "input: every kind",
      "valid": true,
      "spec": {
        "specVersion": 1,
        "id": "w",
        "title": "T",
        "slot": "home.top",
        "state": {
          "name": "",
          "amount": 10,
          "people": 2,
          "tip": true,
          "category": "Food",
          "day": "2026-10-04",
          "notes": null
        },
        "root": {
          "type": "column",
          "children": [
            {
              "type": "input",
              "kind": "text",
              "bind": "name",
              "placeholder": "Name"
            },
            {
              "type": "input",
              "kind": "text",
              "bind": "notes",
              "multiline": true
            },
            {
              "type": "input",
              "kind": "number",
              "bind": "amount",
              "min": -100,
              "step": 0.5
            },
            {
              "type": "input",
              "kind": "slider",
              "bind": "people",
              "min": 1,
              "max": 10,
              "step": 1
            },
            {
              "type": "input",
              "kind": "toggle",
              "bind": "tip",
              "label": "Add tip"
            },
            {
              "type": "input",
              "kind": "select",
              "bind": "category",
              "options": {
                "pluck": [
                  {
                    "var": "tx"
                  },
                  "category"
                ]
              }
            },
            {
              "type": "input",
              "kind": "date",
              "bind": "day"
            },
            {
              "type": "text",
              "value": {
                "if": [
                  {
                    "var": "state.tip"
                  },
                  "tip",
                  "no tip"
                ]
              }
            }
          ]
        },
        "bindings": {
          "perPerson": {
            "/": [
              {
                "var": "state.amount"
              },
              {
                "var": "state.people"
              }
            ]
          }
        }
      }
    },
