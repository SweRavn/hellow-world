{
  "manifest": {
    "app": {
      "name": "Test app"
    },
    "dataSources": {
      "tx": {
        "description": "transactions",
        "schema": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "user": {
        "description": "the user",
        "schema": {
          "type": "object"
        }
      }
    },
    "slots": {
      "home.top": {
        "description": "top of home"
      }
    }
  },
  "cases": [
    {
      "name": "minimal valid",
      "valid": true,
      "spec": {
        "specVersion": 1,
        "id": "w1",
        "title": "T",
        "slot": "home.top",
        "root": {
          "type": "text",
          "value": "hello"
        }
      }
    },
    {
      "name": "valid with bindings and list",
      "valid": true,
      "spec": {
        "specVersion": 1,
        "id": "w2",
        "title": "T",
        "slot": "home.top",
        "bindings": {
          "big": {
            "filter": [
              {
                "var": "tx"
              },
              {
                ">": [
                  {
                    "var": "item.amount"
                  },
                  50
                ]
              }
            ]
          }
        },
        "root": {
          "type": "card",
          "title": "Big spends",
          "children": [
            {
              "type": "list",
              "items": {
                "var": "big"
              },
              "limit": 5,
              "template": {
                "type": "row",
                "children": [
                  {
                    "type": "text",
                    "value": {
                      "var": "item.merchant"
                    }
                  },
                  {
                    "type": "text",
                    "value": {
                      "format": [
                        {
                          "var": "item.amount"
                        },
                        "currency"
                      ]
                    },
                    "color": "negative"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
